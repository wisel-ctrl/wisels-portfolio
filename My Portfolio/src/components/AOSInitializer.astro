<script>
  // This script will run on the client side
  if (typeof window !== 'undefined') {
    const initAOS = async () => {
      try {
        // Dynamically import AOS
        const AOS = (await import('https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js')).default;
        
        AOS.init({
          duration: 800,
          once: false,
          mirror: true,
          offset: 100,
          disable: false
        });
        
        console.log('AOS initialized successfully');
      } catch (error) {
        console.error('Failed to load AOS:', error);
        
        // Fallback: manually show all elements
        const elements = document.querySelectorAll('[data-aos]');
        elements.forEach(el => {
          el.style.opacity = '1';
          el.style.transform = 'none';
        });
      }
    };
    
    // Initialize after DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAOS);
    } else {
      initAOS();
    }
  }
</script>