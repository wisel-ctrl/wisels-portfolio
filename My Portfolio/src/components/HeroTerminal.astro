---
const skills = ['Python', 'MySQL', 'PHP', 'JavaScript', 'HTML', 'CSS', 'PWA', 'GitHub'];
---

<div class="terminal-card p-8 rounded-3xl bg-black/60 backdrop-blur-xl gold-border shadow-2xl">
  <div class="flex items-center gap-2 mb-6">
    <div class="w-3 h-3 rounded-full bg-red-500"></div>
    <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
    <div class="w-3 h-3 rounded-full bg-green-500"></div>
    <span class="ml-2 text-xs font-mono text-gray-500">wesley@portfolio:~</span>
  </div>
  
  <div class="font-mono text-sm space-y-2">
    <div class="flex items-center gap-2">
      <span class="text-yellow-500">❯</span>
      <span class="text-gray-400">profile.load --specialization</span>
    </div>
    
    <div class="ml-6 text-yellow-400">
      BSIT Graduate | Business Analytics | Class of 2025-2026
    </div>
    
    <div class="flex items-center gap-2 mt-4">
      <span class="text-yellow-500">❯</span>
      <span class="text-gray-400">skills.list --proficient</span>
    </div>
    
    <div class="ml-6 flex flex-wrap gap-2 mt-2">
      {skills.map(skill => (
        <span class="px-3 py-1 text-xs font-mono bg-yellow-500/10 text-yellow-400 border border-yellow-500/30 rounded-full hover:bg-yellow-500/20 transition-all cursor-default">
          {skill}
        </span>
      ))}
    </div>
    
    <div class="flex items-center gap-2 mt-4">
      <span class="text-yellow-500">❯</span>
      <span class="text-gray-400">status</span>
    </div>
    
    <div class="ml-6 text-green-400">
      Open to Work: Developer (Hybrid/Remote)
    </div>
    
    <div class="flex items-center gap-2 mt-4">
      <span class="text-yellow-500">❯</span>
      <span class="text-gray-400">location</span>
    </div>
    
    <div class="ml-6 text-yellow-400">
      Laguna, Philippines
    </div>
    
    <div class="flex items-center gap-2 mt-4">
      <span class="text-yellow-500">❯</span>
      <span class="w-3 h-5 bg-yellow-500/50 animate-pulse"></span>
    </div>
  </div>
</div>

<style>
  @keyframes pulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }
  
  .animate-pulse {
    animation: pulse 1.5s infinite;
  }
</style>